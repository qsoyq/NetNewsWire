    "The translation service returned HTTP %ld. Check your API settings and retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation service returned HTTP %ld. Check your API settings and retry."
