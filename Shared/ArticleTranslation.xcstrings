    "Enter an API path such as /responses, without a host or fragment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an API path such as /responses, without a host or fragment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入接口路径，例如 /responses，不要包含域名或锚点。"
          }
        }
      }
    },
    "Translate automatically when you open an article, or use the translation button. Choose to show translations below the original or replace the original. Article titles stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate automatically when you open an article, or use the translation button. Choose to show translations below the original or replace the original. Article titles stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文章后自动翻译，或点击按钮按需翻译。译文可显示在原文下方，也可替换原文。文章标题保持原样。"
          }
        }
      }
    },
    "Base URL and Path form the request address. An empty Path uses /responses. Article text is sent directly to this service. Your API key is saved in Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL and Path form the request address. An empty Path uses /responses. Article text is sent directly to this service. Your API key is saved in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL 与 Path 拼接为请求地址，Path 留空时使用 /responses。文章文本直接发送到该服务，API Key 保存在钥匙串中。"
          }
        }
      }
    },
    "Translate Next Article in Advance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate Next Article in Advance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前翻译下一篇"
          }
        }
      }
    },
    "Translate the next article in advance and save the result for when you open it. This makes additional translation service requests and works independently of image and video prefetching.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the next article in advance and save the result for when you open it. This makes additional translation service requests and works independently of image and video prefetching."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前翻译下一篇文章并缓存，打开时复用译文。此功能会额外调用翻译服务，与图片和视频预加载相互独立。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
