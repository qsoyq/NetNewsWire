        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在「文章翻译」设置中填写 API Key、模型和目标语言。"
          }
        }
      }
    },
    "The translation service returned an invalid response. Please retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The translation service returned an invalid response. Please retry."
