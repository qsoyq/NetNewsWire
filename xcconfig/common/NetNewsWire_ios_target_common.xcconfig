#include "./NetNewsWire_version.xcconfig"

// High Level Settings common to both the iOS application and any extensions we bundle with it
MARKETING_VERSION = 7.0.4

APP_GROUP_ID = group.$(ORGANIZATION_IDENTIFIER).NetNewsWire.iOS$(APP_GROUP_SUFFIX)

// Override with IOS_BUNDLE_ID=<full app bundle id> for local variant builds.
IOS_BUNDLE_ID = $(ORGANIZATION_IDENTIFIER).NetNewsWire.iOS$(BUNDLE_ID_SUFFIX)

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
SDKROOT = iphoneos;
TARGETED_DEVICE_FAMILY = 1,2
